[Unit]
Description=RentFlow staging API and local worker children
After=network.target
RequiresMountsFor=/var/lib/rentflow-staging

[Service]
Type=simple
User=rentflow-staging
Group=rentflow-staging
WorkingDirectory=/opt/rentflow-staging/current
EnvironmentFile=/etc/rentflow-staging/api.env
ExecStart=/opt/node-v24.22.3-linux-x64/bin/node deploy/staging/launch.mjs
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rentflow-staging

[Install]
WantedBy=multi-user.target
